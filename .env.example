# Copy to .env (gitignored, chmod 600) and fill in.
# Cloudflare credentials: same personal account as ../nazoru/.env
#   account 10100291fe85c71daed5efb6a3ff7795
# WARNING: the ambient shell CLOUDFLARE_API_TOKEN belongs to a DIFFERENT account.
# Never run bare `wrangler` — always source this file first.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# LLM for strategy-driven recommendations. Default: Alibaba DashScope qwen3.7-flash.
# Any OpenAI-compatible endpoint works — the model is meant to be swappable.
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.7-flash
